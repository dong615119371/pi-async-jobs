{
  "name": "pi-async-jobs",
  "version": "0.2.1",
  "description": "Background jobs for Pi's agent loop: a slow command stops holding the whole turn, and its result is delivered later as a message.",
  "keywords": [
    "pi-package",
    "pi",
    "async",
    "background-jobs",
    "agent"
  ],
  "license": "MIT",
  "author": "白遇冬夏",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dong615119371/pi-async-jobs.git"
  },
  "homepage": "https://github.com/dong615119371/pi-async-jobs#readme",
  "bugs": {
    "url": "https://github.com/dong615119371/pi-async-jobs/issues"
  },
  "pi": {
    "extensions": [
      "./async-jobs/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "async-jobs/*.ts",
    "!async-jobs/_*.mts",
    "skills/**/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
